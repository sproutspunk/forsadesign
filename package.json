{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs'); for (const file of ['package-lock.json','yarn.lock']) fs.rmSync(file,{force:true}); if (!process.env.npm_config_user_agent?.startsWith('pnpm/')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run format:check",
    "prepare": "husky"
  },
  "private": true,
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,scss,html,md,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.15.2",
      "esbuild": ">=0.28.1",
      "undici": "^7.29.0",
      "form-data": ">=4.0.6",
      "js-yaml": ">=4.3.0",
      "markdown-it": ">=14.2.0",
      "@babel/core": ">=7.29.6",
      "fast-uri": ">=4.1.2",
      "sharp": ">=0.35.0",
      "linkify-it": ">=5.0.2",
      "brace-expansion": ">=5.0.8",
      "body-parser": ">=2.3.0",
      "nodemailer": ">=9.0.3",
      "ip-address": ">=10.3.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.0",
    "wrangler": "^4.110.0"
  }
}

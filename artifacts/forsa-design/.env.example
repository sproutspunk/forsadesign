# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# Required for GA4 to load at all: src/lib/consentManager.ts only injects the
# gtag script when this variable is present AND the user has accepted
# analytics cookies in the cookie-consent banner.
#
# - Local dev: copy this file to `.env.local` and fill in your ID.
# - Production (Cloudflare Pages via GitHub Actions): the value is injected
#   at build time from the GitHub Actions *variable* `VITE_GA_MEASUREMENT_ID`
#   (see .github/workflows/deploy.yml).
#
# Note: this ID is not a secret - it is visible in the public client bundle.
VITE_GA_MEASUREMENT_ID=G-9QKVVE4QXE
